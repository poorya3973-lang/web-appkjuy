{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "web-appkjuy",
  "main": "worker.js",
  "compatibility_date": "2026-07-30",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    { "binding": "DB","database_id": "1cc5737b-e950-466d-bd1e-e09e17ae4bbc","database_name": "web-appalpokiu" }
  ],
  "kv_namespaces": [
    { "binding": "KV","id": "1dae3dbc069d4f3494789613e0707dcd" }
  ],
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
